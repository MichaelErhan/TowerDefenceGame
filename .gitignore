5. Напишите программную реализацию бинанрного дерева поиска.
package com.example;

// Класс узла дерева
class TreeNode {
    int value;
    TreeNode left;
    TreeNode right;

    TreeNode(int value) {
        this.value = value;
        left = null;
        right = null;
    }
}

// Класс бинарного дерева поиска
class BinarySearchTree {
    private TreeNode root;

    // Метод для вставки значения
    public void insert(int value) {
        root = insertRec(root, value);
    }

    private TreeNode insertRec(TreeNode node, int value) {
        if (node == null) {
            return new TreeNode(value);
        }
        if (value < node.value) {
            node.left = insertRec(node.left, value);
        } else if (value > node.value) {
            node.right = insertRec(node.right, value);
        }
        return node;
    }

    // Метод для поиска значения
    public boolean search(int value) {
        return searchRec(root, value);
    }

    private boolean searchRec(TreeNode node, int value) {
        if (node == null) {
            return false;
        }
        if (node.value == value) {
            return true;
        }
        return value < node.value ? searchRec(node.left, value) : searchRec(node.right, value);
    }

    // Метод для вывода дерева (обход в порядке возрастания)
    public void inOrderTraversal() {
        inOrderRec(root);
    }

    private void inOrderRec(TreeNode node) {
        if (node != null) {
            inOrderRec(node.left);
            System.out.print(node.value + " ");
            inOrderRec(node.right);
        }
    }
}

// Основной класс для тестирования
public class BinaryTreeApp {
    public static void main(String[] args) {
        BinarySearchTree bst = new BinarySearchTree();

        // Добавление значений
        bst.insert(50);
        bst.insert(30);
        bst.insert(20);
        bst.insert(40);
        bst.insert(70);
        bst.insert(60);
        bst.insert(80);

        System.out.println("Обход дерева (in-order):");
        bst.inOrderTraversal(); // 20 30 40 50 60 70 80

        // Поиск значения
        System.out.println("\nПоиск 40: " + bst.search(40)); // true
        System.out.println("Поиск 90: " + bst.search(90)); // false
    }
}

4. Написать калькулятор для строковых выражений вида число операция число
package com.example;

import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class TextualCalculator {
    // Карта для преобразования текста в числа
    private static final Map<String, Integer> textToNumber = new HashMap<>();
    private static final Map<Integer, String> numberToText = new HashMap<>();

    static {
        // Инициализация карты текста в числа
        textToNumber.put("ноль", 0);
        textToNumber.put("один", 1);
        textToNumber.put("два", 2);
        textToNumber.put("три", 3);
        textToNumber.put("четыре", 4);
        textToNumber.put("пять", 5);
        textToNumber.put("шесть", 6);
        textToNumber.put("семь", 7);
        textToNumber.put("восемь", 8);
        textToNumber.put("девять", 9);
        textToNumber.put("десять", 10);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Текстовый калькулятор запущен.");
        System.out.println("Введите выражение в формате: <число> <операция> <число>");
        System.out.println("Пример: пять плюс три");

        while (true) {
            System.out.print("\nВаше выражение (или 'выход' для завершения): ");
            String input = scanner.nextLine().toLowerCase().trim();

            if (input.equals("выход")) {
                System.out.println("Завершение программы...");
                break;
            }

            try {
                // Вычисляем результат
                String result = calculate(input);
                System.out.println("Результат: " + result);
            } catch (IllegalArgumentException e) {
                System.out.println("Ошибка: " + e.getMessage());
            }
        }
    }

    public static String calculate(String input) {
        // Разбиваем строку на части
        String[] parts = input.split("\\s+");

        if (parts.length != 3) {
            throw new IllegalArgumentException("Неверный формат выражения. Ожидается: <число> <операция> <число>.");
        }

        // Получаем числа и операцию
        int num1 = parseNumber(parts[0]);
        int num2 = parseNumber(parts[2]);
        String operation = parts[1];

        // Выполняем операцию
        int result = performOperation(num1, num2, operation);

        // Преобразуем результат в текст
        return convertNumberToText(result);
    }

    private static int parseNumber(String text) {
        Integer number = textToNumber.get(text);
        if (number == null) {
            throw new IllegalArgumentException("Неизвестное число: " + text);
        }
        return number;
    }

    private static int performOperation(int num1, int num2, String operation) {
        switch (operation) {
            case "плюс":
                return num1 + num2;
            case "минус":
                return num1 - num2;
            case "умножить":
                return num1 * num2;
            case "делить":
                if (num2 == 0) {
                    throw new IllegalArgumentException("Деление на ноль невозможно.");
                }
                return num1 / num2;
            default:
                throw new IllegalArgumentException("Неизвестная операция: " + operation);
        }
    }

    private static String convertNumberToText(int number) {
        if (numberToText.containsKey(number)) {
            return numberToText.get(number);
        }

        StringBuilder result = new StringBuilder();
        if (number < 0) {
            result.append("минус ");
            number = -number;
        }

        if (number == 0) {
            return "ноль";
        }

        String[] units = {"", "один", "два", "три", "четыре", "пять", "шесть", "семь", "восемь", "девять"};
        String[] tens = {"", "десять", "двадцать", "тридцать", "сорок", "пятьдесят", "шестьдесят", "семьдесят", "восемьдесят", "девяносто"};
        String[] teens = {"", "одиннадцать", "двенадцать", "тринадцать", "четырнадцать", "пятнадцать", "шестнадцать", "семнадцать", "восемнадцать", "девятнадцать"};

        int hundreds = number / 100;
        int remainder = number % 100;

        if (hundreds > 0) {
            result.append(units[hundreds]).append("сот ");
        }

        if (remainder >= 11 && remainder <= 19) {
            result.append(teens[remainder - 10]);
        } else {
            int tensPart = remainder / 10;
            int unitsPart = remainder % 10;

            if (tensPart > 0) {
                result.append(tens[tensPart]).append(" ");
            }
            if (unitsPart > 0) {
                result.append(units[unitsPart]);
            }
        }

        return result.toString().trim();
    }
}

9. Напишите программу, которая по дате определяет день недели, на который эта дата
приходится.
package com.example;

import java.util.Scanner;
import java.text.SimpleDateFormat;
import java.util.Date;

public class DayOfWeek {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        while (true) {
            // Просим пользователя ввести дату или команду выхода
            System.out.println("Введите дату в формате (день-месяц-год) или напишите 'выход' для завершения: ");
            String inputDate = scanner.nextLine();

            // Если введено "выход", завершаем программу
            if (inputDate.equalsIgnoreCase("выход")) {
                System.out.println("Программа завершена.");
                break;
            }

            try {
                // Создаем объект SimpleDateFormat для парсинга даты
                SimpleDateFormat sdf = new SimpleDateFormat("dd-MM-yyyy");
                Date date = sdf.parse(inputDate);

                // Создаем объект SimpleDateFormat для вывода дня недели
                SimpleDateFormat dayFormat = new SimpleDateFormat("EEEE");

                // Выводим день недели
                String dayOfWeek = dayFormat.format(date);
                System.out.println("День недели: " + dayOfWeek);
            } catch (Exception e) {
                System.out.println("Некорректный формат даты. Пожалуйста, введите дату в формате (день-месяц-год).");
            }
        }

        scanner.close();
    }
}

11. Разработайте программу, реализующую рекурсивное вычисление факториала.
package com.example;

import java.util.Scanner;

public class Factorial {
    // Рекурсивная функция для вычисления факториала
    public static int factorial(int n) {
        // Базовый случай: факториал 0 или 1 равен 1
        if (n == 0 || n == 1) {
            return 1;
        }
        // Рекурсивный случай
        return n * factorial(n - 1);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        while (true) {
            // Запрашиваем у пользователя число для вычисления факториала или команду выхода
            System.out.print("Введите число для вычисления факториала или 'выход' для завершения: ");
            String input = scanner.nextLine();

            // Если введено "выход", завершаем программу
            if (input.equalsIgnoreCase("выход")) {
                System.out.println("Программа завершена.");
                break;
            }

            try {
                // Преобразуем введенную строку в число
                int num = Integer.parseInt(input);

                // Проверяем, чтобы число было неотрицательным
                if (num < 0) {
                    System.out.println("Факториал для отрицательного числа не существует.");
                } else {
                    // Выводим результат
                    System.out.println("Факториал числа " + num + " равен " + factorial(num));
                }
            } catch (NumberFormatException e) {
                System.out.println("Пожалуйста, введите корректное число или 'выход'.");
            }
        }

        scanner.close();
    }
}


12. Разработать класс-оболочку для числового типа double. Реализовать статические
методы сложения, деления, возведения в степень.
package com.example;

import java.util.Scanner;

public class DoubleWrapper {
    private double value;

    // Конструктор, принимающий значение типа double
    public DoubleWrapper(double value) {
        this.value = value;
    }

    // Метод для получения значения
    public double getValue() {
        return value;
    }

    // Статический метод сложения двух чисел типа double
    public static double add(double a, double b) {
        return a + b;
    }

    // Статический метод деления двух чисел типа double
    public static double divide(double a, double b) {
        if (b == 0) {
            throw new ArithmeticException("Деление на ноль невозможно.");
        }
        return a / b;
    }

    // Статический метод возведения числа в степень
    public static double power(double a, double b) {
        return Math.pow(a, b);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        while (true) {
            // Запрашиваем операцию
            System.out.println("Выберите операцию: ");
            System.out.println("1. Сложение");
            System.out.println("2. Деление");
            System.out.println("3. Возведение в степень");
            System.out.println("Введите 'выход' для завершения.");

            String choice = scanner.nextLine();

            // Проверяем, не хочет ли пользователь выйти
            if (choice.equalsIgnoreCase("выход")) {
                System.out.println("Программа завершена.");
                break;
            }

            double num1, num2;

            try {
                // Вводим два числа
                System.out.print("Введите первое число: ");
                num1 = Double.parseDouble(scanner.nextLine());

                System.out.print("Введите второе число: ");
                num2 = Double.parseDouble(scanner.nextLine());
            } catch (NumberFormatException e) {
                System.out.println("Ошибка ввода. Пожалуйста, введите числовые значения.");
                continue;
            }

            switch (choice) {
                case "1":
                    // Выполняем сложение
                    double sum = DoubleWrapper.add(num1, num2);
                    System.out.println("Результат сложения: " + sum);
                    break;

                case "2":
                    // Выполняем деление
                    try {
                        double division = DoubleWrapper.divide(num1, num2);
                        System.out.println("Результат деления: " + division);
                    } catch (ArithmeticException e) {
                        System.out.println(e.getMessage());
                    }
                    break;

                case "3":
                    // Выполняем возведение в степень
                    double power = DoubleWrapper.power(num1, num2);
                    System.out.println("Результат возведения в степень: " + power);
                    break;

                default:
                    System.out.println("Неверный выбор операции. Попробуйте снова.");
            }
        }

        scanner.close();
    }
}


16. Создать интерфейс Progress c методами вычисления любого элемента прогрессии и
суммы прогрессии. Разработать классы арифметической и геометрической прогрессии, которые
имплементируют интерфейс Progress.
package com.example;

// Интерфейс Progress
interface Progress {
    // Метод для вычисления n-го элемента прогрессии
    double getElement(int n);

    // Метод для вычисления суммы первых n элементов прогрессии
    double getSum(int n);
}

// Класс для арифметической прогрессии
class ArithmeticProgression implements Progress {
    private double firstTerm;  // Первый элемент прогрессии
    private double commonDifference;  // Разность прогрессии

    // Конструктор
    public ArithmeticProgression(double firstTerm, double commonDifference) {
        this.firstTerm = firstTerm;
        this.commonDifference = commonDifference;
    }

    @Override
    public double getElement(int n) {
        // Формула n-го элемента арифметической прогрессии: a_n = a_1 + (n - 1) * d
        return firstTerm + (n - 1) * commonDifference;
    }

    @Override
    public double getSum(int n) {
        // Формула суммы первых n элементов арифметической прогрессии: S_n = n / 2 * (2a_1 + (n - 1) * d)
        return n / 2.0 * (2 * firstTerm + (n - 1) * commonDifference);
    }
}

// Класс для геометрической прогрессии
class GeometricProgression implements Progress {
    private double firstTerm;  // Первый элемент прогрессии
    private double commonRatio;  // Знаменатель прогрессии

    // Конструктор
    public GeometricProgression(double firstTerm, double commonRatio) {
        this.firstTerm = firstTerm;
        this.commonRatio = commonRatio;
    }

    @Override
    public double getElement(int n) {
        // Формула n-го элемента геометрической прогрессии: a_n = a_1 * r^(n-1)
        return firstTerm * Math.pow(commonRatio, n - 1);
    }

    @Override
    public double getSum(int n) {
        // Формула суммы первых n элементов геометрической прогрессии: S_n = a_1 * (1 - r^n) / (1 - r), если r != 1
        if (commonRatio == 1) {
            return firstTerm * n;  // Если знаменатель 1, то просто умножаем первый элемент на n
        } else {
            return firstTerm * (1 - Math.pow(commonRatio, n)) / (1 - commonRatio);
        }
    }
}

public class Main {
    public static void main(String[] args) {
        // Пример использования арифметической прогрессии
        Progress arithmetic = new ArithmeticProgression(2, 3);  // a_1 = 2, d = 3
        System.out.println("Арифметическая прогрессия:");
        System.out.println("5-й элемент: " + arithmetic.getElement(5));  // a_5 = 2 + (5 - 1) * 3 = 14
        System.out.println("Сумма первых 5 элементов: " + arithmetic.getSum(5));  // S_5 = 5 / 2 * (2 * 2 + (5 - 1) * 3) = 40.0

        // Пример использования геометрической прогрессии
        Progress geometric = new GeometricProgression(3, 2);  // a_1 = 3, r = 2
        System.out.println("\nГеометрическая прогрессия:");
        System.out.println("4-й элемент: " + geometric.getElement(4));  // a_4 = 3 * 2^(4 - 1) = 24.0
        System.out.println("Сумма первых 4 элементов: " + geometric.getSum(4));  // S_4 = 3 * (1 - 2^4) / (1 - 2) = 45.0
    }
}


41. Условие задачи: «Ввести две строки (не менее 50 символов каждая) с клавиатуры.
Необходимо вывести на экран две введенных ранее строки, подсчитать и вывести размер длины
каждой строки, объединить данные строки в одну, сравнить данные строки и результат сравнения
вывести на экран». По данному условию необходимо реализовать программу с интерактивным
консольным меню, (т.е. вывод списка действий по цифрам. При этом при нажатии на цифру у нас
должно выполняться определенное действие). При этом в программе данные пункты должны
называться следующим образом:
	1. Вывести все таблицы из MySQL.
	2. Создать таблицу в MySQL.
	3. Ввести две строки с клавиатуры, результат сохранить в MySQL с последующим
	выводом в консоль.
	4. Подсчитать размер ранее введенных строк, результат сохранить в MySQL с
	последующим выводом в консоль.
	5. Объединить две строки в единое целое, результат сохранить в MySQL с последующим
	выводом в консоль.
	6. Сравнить две ранее введенные строки, результат сохранить в MySQL с последующим
	выводом в консоль.
	7. Сохранить все данные (вышеполученные результаты) из MySQL в Excel и вывести на
	экран

package org.example;

import java.sql.*;
import java.util.Scanner;
import java.io.File;
import java.io.FileWriter;
import java.io.IOException;

public class Main {

    private static final String DATABASE_URL = "jdbc:mysql://localhost:3306/";

    private static final String USERNAME = "root";
    private static final String PASSWORD = "root";

    private static final String DATABASE_NAME = "Demo";
    private static final String TABLE_NAME = "strings";

    private static String string1 = null;
    private static String string2 = null;

    public static void main(String[] args) {
        try (Connection connection = DriverManager.getConnection(DATABASE_URL, USERNAME, PASSWORD)) {
            System.out.println("Успешное подключение к базе данных!");

            createDataBase(connection);

            try(Connection connection2 = DriverManager.getConnection(DATABASE_URL + DATABASE_NAME, USERNAME, PASSWORD)) {
                Scanner scanner = new Scanner(System.in);
                while (true) {
                    System.out.println("\n=== Консольное меню ===");
                    System.out.println("1. Вывести все таблицы из MySQL");
                    System.out.println("2. Создать таблицу в MySQL");
                    System.out.println("3. Ввести две строки с клавиатуры и сохранить в MySQL");
                    System.out.println("4. Подсчитать размер строк и сохранить в MySQL");
                    System.out.println("5. Объединить строки и сохранить в MySQL");
                    System.out.println("6. Сравнить строки и сохранить в MySQL");
                    System.out.println("7. Сохранить все данные из MySQL в Excel");
                    System.out.println("8. Выход из программы");
                    System.out.print("Выберите действие: ");

                    int choice = scanner.nextInt();
                    scanner.nextLine(); // Очистка буфера

                    switch (choice) {
                        case 1:
                            listTables(connection2);
                            break;
                        case 2:
                            createTable(connection2);
                            break;
                        case 3:
                            inputStrings(scanner, connection2);
                            break;
                        case 4:
                            calculateLengths(connection2);
                            break;
                        case 5:
                            concatenateStrings(connection2);
                            break;
                        case 6:
                            compareStrings(connection2);
                            break;
                        case 7:
                            saveToExcel(connection2);
                            break;
                        case 8:
                            System.out.println("Выход из программы. До свидания!");
                            System.exit(0);
                            break;
                        default:
                            System.out.println("Неверный выбор. Попробуйте снова.");
                    }
                }
            }


        } catch (SQLException e) {
            System.out.println("Ошибка подключения к базе данных: " + e.getMessage());
        }
    }

    private static void createDataBase(Connection connection) throws SQLException {
        String createBaseSQL = "CREATE DATABASE IF NOT EXISTS " + DATABASE_NAME;
        try (Statement statement = connection.createStatement()) {
            statement.executeUpdate(createBaseSQL);
            System.out.println("\n Успешно создана База Данных " + DATABASE_NAME);
        }
    }

    private static void listTables(Connection connection) throws SQLException {
        String query = "SHOW TABLES";
        try (Statement statement = connection.createStatement()) {
            ResultSet resultSet = statement.executeQuery(query);
            while (resultSet.next()) {
                System.out.println(resultSet.getString(1));
            }
        }
    }

    private static void createTable(Connection connection) throws SQLException {
        String createTableSQL = "CREATE TABLE IF NOT EXISTS " + TABLE_NAME + " ("
                + "id INT AUTO_INCREMENT PRIMARY KEY, "
                + "string1 TEXT, "
                + "string2 TEXT, "
                + "length1 INT, "
                + "length2 INT, "
                + "concatenated TEXT, "
                + "comparison TEXT)";

        try (Statement statement = connection.createStatement()) {
            statement.executeUpdate(createTableSQL);
            System.out.println("\n Таблица " + TABLE_NAME + " успешно создана!");
        }

    }

    private static void inputStrings(Scanner scanner, Connection connection) throws SQLException {
        System.out.println("\n Введите первую строку (не менее 50 символов):");
        string1 = scanner.nextLine();
        while (string1.length() < 50) {
            System.out.println("\n Ошибка: строка должна содержать не менее 50 символов. Повторите ввод:");
            string1 = scanner.nextLine();
        }

        System.out.println("\n Введите вторую строку (не менее 50 символов):");
        string2 = scanner.nextLine();
        while (string2.length() < 50) {
            System.out.println("\n Ошибка: строка должна содержать не менее 50 символов. Повторите ввод:");
            string2 = scanner.nextLine();
        }

        String insertSQL = "INSERT INTO " + TABLE_NAME + " (string1, string2) VALUES (?, ?)";
        try (PreparedStatement pstmt = connection.prepareStatement(insertSQL)) {
            pstmt.setString(1, string1);
            pstmt.setString(2, string2);
            pstmt.executeUpdate();
            System.out.println("\n Строки успешно сохранены в MySQL!");
        }
    }

    private static void calculateLengths(Connection connection) throws SQLException {
        if (string1 != null && string2 != null) {
            int length1 = string1.length();
            int length2 = string2.length();

            String updateSQL = "UPDATE " + TABLE_NAME + " SET length1 = ?, length2 = ? WHERE string1 = ? AND string2 = ?";
            try (PreparedStatement pstmt = connection.prepareStatement(updateSQL)) {
                pstmt.setInt(1, length1);
                pstmt.setInt(2, length2);
                pstmt.setString(3, string1);
                pstmt.setString(4, string2);
                pstmt.executeUpdate();
                System.out.println("\n Длины строк сохранены в MySQL!");
                System.out.println("\n Длина первой строки: "+length1 + "\n" + "Длина второй строки" + length2);
            }
        } else {
            System.out.println("\n Сначала введите строки (выберите действие 3).");
        }
    }

    private static void concatenateStrings(Connection connection) throws SQLException {
        if (string1 != null && string2 != null) {
            String concatenated = string1 + string2;

            String updateSQL = "UPDATE " + TABLE_NAME + " SET concatenated = ? WHERE string1 = ? AND string2 = ?";
            try (PreparedStatement pstmt = connection.prepareStatement(updateSQL)) {
                pstmt.setString(1, concatenated);
                pstmt.setString(2, string1);
                pstmt.setString(3, string2);
                pstmt.executeUpdate();
                System.out.println("\n Объединенная строка сохранена в MySQL!");
                System.out.println(concatenated);
            }
        } else {
            System.out.println("\n Сначала введите строки (выберите действие 3).");
        }
    }

    private static void compareStrings(Connection connection) throws SQLException {
        if (string1 != null && string2 != null) {
            String comparison = string1.equals(string2) ? "Равны" : "Не равны";

            String updateSQL = "UPDATE " + TABLE_NAME + " SET comparison = ? WHERE string1 = ? AND string2 = ?";
            try (PreparedStatement pstmt = connection.prepareStatement(updateSQL)) {
                pstmt.setString(1, comparison);
                pstmt.setString(2, string1);
                pstmt.setString(3, string2);
                pstmt.executeUpdate();
                System.out.println("\n Результат сравнения строк сохранен в MySQL!");
                System.out.println(comparison);
            }
        } else {
            System.out.println("\n Сначала введите строки (выберите действие 3).");
        }
    }

    private static void saveToExcel(Connection connection) throws SQLException {
        String query = "SELECT * FROM " + TABLE_NAME;
        try (Statement stmt = connection.createStatement();
             ResultSet rs = stmt.executeQuery(query)) {

            File file = new File("output.csv");
            try (FileWriter writer = new FileWriter(file)) {
                writer.write("ID,String1,String2,Length1,Length2,Concatenated,Comparison\n");
                while (rs.next()) {
                    writer.write(rs.getInt("id") + ","
                            + rs.getString("string1") + ","
                            + rs.getString("string2") + ","
                            + rs.getInt("length1") + ","
                            + rs.getInt("length2") + ","
                            + rs.getString("concatenated") + ","
                            + rs.getString("comparison") + "\n");
                }
                System.out.println("\n Данные сохранены в файл output.csv!");
            } catch (IOException e) {
                System.out.println("\n Ошибка сохранения в файл: " + e.getMessage());
            }
        }
    }
}


21. Разработать программу для игры «Угадайка». Программа загадывает случайное число
от 1 до 10, требуется его отгадать с трех попыток. После каждой попытки, если результат неверен,
игроку выводится сообщение, меньше или больше названное игроком число, чем загаданное. Сет
заканчивается или если игрок угадывает число, или если исчерпывает три попытки, не угадав.
Игра должна быть выполнена в бесконечном цикле, и продолжается до тех пор, пока на
предложение «Сыграем еще раз?» игрок не напишет «Нет».

package org.example;

import java.util.Random;
import java.util.Scanner;

public class GuessGame {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        // Главный цикл игры
        while (true) {
            // Загадать случайное число от 1 до 10
            int numberToGuess = random.nextInt(10) + 1;
            int attemptsLeft = 3;
            boolean guessedCorrectly = false;

            System.out.println("Я загадал число от 1 до 10. Попробуй угадать!");

            // Цикл для трёх попыток
            while (attemptsLeft > 0) {
                System.out.print("Введи число: ");
                int playerGuess = scanner.nextInt();

                if (playerGuess == numberToGuess) {
                    System.out.println("Поздравляю! Ты угадал число!");
                    guessedCorrectly = true;
                    break;
                } else if (playerGuess < numberToGuess) {
                    System.out.println("Загаданное число больше.");
                } else {
                    System.out.println("Загаданное число меньше.");
                }

                attemptsLeft--;
                System.out.println("Осталось попыток: " + attemptsLeft);
            }

            if (!guessedCorrectly) {
                System.out.println("Ты не угадал! Загаданное число было: " + numberToGuess);
            }

            // Спрашиваем, хочет ли игрок сыграть еще раз
            System.out.print("Сыграем еще раз? (Да/Нет): ");
            String playAgain = scanner.next();
            if (playAgain.equalsIgnoreCase("Нет")) {
                System.out.println("Спасибо за игру!");
                break;
            }
        }

        scanner.close();
    }
}


40. Напишите программу, которая каждые 5 секунд отображает на экране данные о
времени, прошедшем от начала запуска программы, а другой её поток выводит сообщение
каждые 7 секунд. Третий поток выводит на экран сообщение каждые 10 секунд. Программа
работает одну минуту, затем останавливается. Все результаты после вывода необходимо
сохранить в MySQL/PostgreSQL.
package org.example;

import java.sql.*;

public class Test {

    private static final String DataBaseUrl = "jdbc:mysql://localhost:3306/";
    private static final String UserName = "root";
    private static final String Password = "root";
    private static final String DataBaseName = "PotokiBase";
    private static final String TableName = "Potoki";

    public static void main(String[] args) {
        try (Connection connection = DriverManager.getConnection(DataBaseUrl, UserName, Password)) {
            System.out.println("Connected to database");
            createDataBase(connection);

            try (Connection connection2 = DriverManager.getConnection(DataBaseUrl + DataBaseName, UserName, Password)) {
                System.out.println("Connected to database");
                createTable(connection2);

                TimeTask timeTask = new TimeTask(connection2);
                Thread timeThread = new Thread(timeTask);
                timeThread.start();

                MessageTask messageTask1 = new MessageTask(connection2, 7, "Сообщение каждые 7 секунд");
                Thread messageThread1 = new Thread(messageTask1);
                messageThread1.start();

                MessageTask messageTask2 = new MessageTask(connection2, 10, "Сообщение каждые 10 секунд");
                Thread messageThread2 = new Thread(messageTask2);
                messageThread2.start();

                try {
                    Thread.sleep(60000); // 60 секунд
                } catch (InterruptedException e) {
                    e.printStackTrace();
                }

                timeThread.interrupt();
                messageThread1.interrupt();
                messageThread2.interrupt();
            }
        } catch (SQLException e) {
            throw new RuntimeException(e);
        }
    }

    private static void createDataBase(Connection connection) throws SQLException {
        String createBaseSQL = "CREATE DATABASE IF NOT EXISTS " + DataBaseName;
        try (Statement statement = connection.createStatement()) {
            statement.executeUpdate(createBaseSQL);
        }
    }

    private static void createTable(Connection connection) throws SQLException {
        String createTableSQL = "CREATE TABLE IF NOT EXISTS " + TableName + "("
                + "id INTEGER PRIMARY KEY AUTO_INCREMENT, "
                + "name_potok VARCHAR(255), "
                + "time_potok INTEGER)";
        try (Statement statement = connection.createStatement()) {
            statement.executeUpdate(createTableSQL);
        }
    }

    public static void insertData(Connection connection, String name_potok, Integer time_potok) throws SQLException {
        String insertDataSQL = "INSERT INTO " + TableName + "(name_potok, time_potok) VALUES(?, ?)";
        try (PreparedStatement preparedStatement = connection.prepareStatement(insertDataSQL)) {
            preparedStatement.setString(1, name_potok);
            preparedStatement.setInt(2, time_potok);
            preparedStatement.executeUpdate();
        }
    }
}

class TimeTask implements Runnable {
    private long startTime = System.currentTimeMillis();
    private Connection connection;

    public TimeTask(Connection connection) {
        this.connection = connection;
    }

    @Override
    public void run() {
        while (!Thread.currentThread().isInterrupted()) {
            long elapsedTime = (System.currentTimeMillis() - startTime) / 1000;
            System.out.println("Время, прошедшее с начала программы: " + elapsedTime + " секунд");
            try {
                Test.insertData(connection, "TimeThread", (int) elapsedTime);
                Thread.sleep(5000); // Каждые 5 секунд
            } catch (InterruptedException | SQLException e) {
                Thread.currentThread().interrupt();
            }
        }
    }
}

class MessageTask implements Runnable {
    private int interval;
    private String message;
    private Connection connection;

    public MessageTask(Connection connection, int interval, String message) {
        this.connection = connection;
        this.interval = interval;
        this.message = message;
    }

    @Override
    public void run() {
        while (!Thread.currentThread().isInterrupted()) {
            System.out.println(message);
            try {
                Test.insertData(connection, message, interval);
                Thread.sleep(interval * 1000); // Интервал в секундах
            } catch (InterruptedException | SQLException e) {
                Thread.currentThread().interrupt();
            }
        }
    }
}

46. Разработать приложение для работы с локальной базой данных MySQL. Создайте базу
данных мобильных телефонов (не менее 10 позиций), со следующими полями: производитель,модель, год выпуска, диагональ экрана. Напишите методы для выполнения запросов к базе
данных. Все данные должны выводиться в консоли на экран.
package org.example;

import java.sql.*;

public class Main {

    private static final String DataBaseURL = "jdbc:mysql://localhost:3306/";
    private static final String User = "root";
    private static final String Password = "root";
    private static final String DatabaseName = "mobile_db";

    public static void main(String[] args) {

        try (Connection connection = DriverManager.getConnection(DataBaseURL, User, Password)) {

            System.out.println("Connected to MySQL server");

            /** Создал базу данных **/
            createDatabaseIfNotExists(connection);

            try (Connection dbConnection = DriverManager.getConnection(DataBaseURL + DatabaseName, User, Password)) {
                createTable(dbConnection);

                insertPhone(dbConnection, "Apple", "iphone 5", 2016, 6.0);
                insertPhone(dbConnection, "Apple","iphone 5s" , 2017,6.1);
                insertPhone(dbConnection, "Apple","iphone 6" , 2018,6.2);
                insertPhone(dbConnection, "Apple","iphone 6mini" , 2019,6.3);
                insertPhone(dbConnection, "Apple","iphone 7" , 2020,6.4);
                insertPhone(dbConnection, "Apple","iphone 7s" , 2021,6.5);
                insertPhone(dbConnection, "Apple","iphone 8" , 2022,6.6);
                insertPhone(dbConnection, "Apple","iphone 8s" , 2023,6.7);
                insertPhone(dbConnection, "Apple","iphone 12" , 2024,6.8);
                insertPhone(dbConnection, "Apple","iphone 12 pro" , 2025,6.9);

            }

        } catch (SQLException e) {
            e.printStackTrace();
            throw new RuntimeException(e);
        }
    }

    private static void createDatabaseIfNotExists(Connection connection) throws SQLException {
        String createDatabaseSQL = "CREATE DATABASE IF NOT EXISTS " + DatabaseName;
        try (Statement statement = connection.createStatement()) {
            statement.executeUpdate(createDatabaseSQL);
            System.out.println("Database " + DatabaseName + " created or already exists");
        }
    }

    private static void createTable(Connection connection) throws SQLException {
        String createTableSQL = "CREATE TABLE IF NOT EXISTS phones ("
                + "id INT AUTO_INCREMENT PRIMARY KEY,"
                + "manufactures VARCHAR(50),"
                + "models VARCHAR(50),"
                + "release_year INT,"
                + "screen_size DOUBLE)";
        try (Statement statement = connection.createStatement()) {
            statement.executeUpdate(createTableSQL);
            System.out.println("Table 'phones' created");
        }
    }

    private static void insertPhone(Connection connection, String manufactures,String models, int release_year, double screen_size) throws SQLException {
        String insertPhoneSQL = "INSERT INTO phones (manufactures,models,release_year,screen_size) VALUES (?,?,?,?)";
        try (PreparedStatement statement = connection.prepareStatement(insertPhoneSQL)) {
            statement.setString(1, manufactures);
            statement.setString(2, models);
            statement.setInt(3, release_year);
            statement.setDouble(4, screen_size);
            statement.executeUpdate();
            System.out.println("Phone " + manufactures + " inserted");
        }
    }
}

